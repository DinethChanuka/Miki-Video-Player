{
  "name": "aether-player",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "tauri": "tauri",
    "package:mac": "./scripts/package-mac.sh",
    "package:win": "tauri build --target x86_64-pc-windows-msvc",
    "package:android": "./scripts/package-android.sh",
    "package:ios": "./scripts/package-ios.sh",
    "generate:ico": "node scripts/generate-windows-ico.cjs",
    "validate:media": "java AetherPlayerLauncher --validate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
